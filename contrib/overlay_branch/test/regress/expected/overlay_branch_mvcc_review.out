            THEN 'PASS:AP1_1_APPLY_DUI_OK'
            ELSE 'FAIL:AP1_1 '||COALESCE(string_agg(id::text||'='||v, ',' ORDER BY id),'NULL')
       END AS ap1_1
FROM public.ap1_t;
