SELECT currval('overlay_branch.pg_branch_branch_id_seq') = :'id_c'
       AND :'id_c'::int > :'id_b'::int AS r09_c_id_matches_currval_and_monotonic;
 r09_c_id_matches_currval_and_monotonic 
