/* contrib/overlay_branch/test/regress/sql/overlay_branch_mvcc_bounds.sql */
/*
 * overlay_branch_mvcc_bounds.sql — V3 MVCC 高级边界/并发语义/FR6/FR7 回归。
 *
 * COVERAGE（原 overlay_branch_mvcc.sql SECTION L/M/N/O/P/Q，单 session 自包含）：
 *   SECTION L — FR2 Branch Advisory Lock 密钥等价：C 侧 use_branch(SHARED) ↔ SQL 侧
 *             pg_advisory_xact_lock_shared(int8) 同 key 0x4F42<<48 | bid 重入；
 *             L1 S→X upgrade / L2 discard X-only / L3 S→X discard / L4 key bitcast 等价
 *   SECTION M — apply_branch/discard_branch same-session ERROR 捕获（单 session 确定性
 *             100 行 MAIN baseline + 10 delta → apply 回放 ERROR + discard 回滚正确）
 *   SECTION N — Cross-branch isolation + FR1 NOTIFY：b2 die, b3 不受影响；
 *             ob_branch_state channel payload 格式 bid:applied/discarded/applying
 *   SECTION O — API 边界：use_branch("") 双路径、invalid mode ERRCODE、
 *             apply/discard on APPLIED/DISCARDED/not_exist → undefined_object / prereq_state
 *   SECTION P — FR6 BranchScan rescan/rewind：CustomScanState ExecCustomScan 节点复用
 *             → 4 步 materialize+rescan（2 MAIN + 1 WR delta → rescan 读回一致）
 *   SECTION Q — FR7 GUC ABI：取消 3 个已延期 GUC，剩余 4 项默认值 roundtrip 不变
 *
 * 每段之间 DISCARD ALL 隔离（clean session baseline per section）。
 */
/* ---------- PRE-REQUISITE: shared_preload_libraries hook loaded ---------- */
DO $$
BEGIN
    IF current_setting('shared_preload_libraries', true) IS NULL
       OR current_setting('shared_preload_libraries', true)
          NOT LIKE '%overlay_branch%'
    THEN
        RAISE EXCEPTION
            'FAIL:PREQUISITE shared_preload_libraries must include overlay_branch. '
            'Hint: use the Makefile recipe (make install-home + make check), '
            'NOT bare pg_regress without --temp-config=.../temp_instance_shared_libs.conf.';
    END IF;
END $$;
CREATE EXTENSION IF NOT EXISTS overlay_branch;
NOTICE:  extension "overlay_branch" already exists, skipping
SET client_min_messages = WARNING;
