SELECT CASE
         WHEN bit_or(1 << id) = (1<<1) | (1<<2) | (1<<3) | (1<<4)
         THEN 'PASS:pk_mask_1234'
         ELSE 'FAIL:mask='||bit_or(1 << id)::text
       END AS p_tr6_2_pk_mask_status
  FROM public.fr6_t WHERE id BETWEEN 1 AND 4;
