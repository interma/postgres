/* contrib/overlay_branch/test/sql/overlay_branch_mvcc.sql */
/*
 * overlay_branch_mvcc.sql — V3 multi-session MVCC core semantics regression test.
 *
 * MERGED FILE: This file consolidates the former two independent test suites
 * (overlay_branch_mode_param.sql + overlay_branch_invalidation.sql) into one
 * comprehensive regression test for the V3 MVCC runtime.
 *
 * COVERAGE (two blocks, ~150 deterministic assertions):
 *
 *   T1 — 2-param use_branch(branch_name, mode) semantics (PART A-F):
 *     • signature 1-arg vs 2-arg overload; invalid mode / NULL / nonexistent
 *       branch are all rejected with the correct errcode
 *     • default mode = SNAPSHOT; explicit 'snapshot' / 'live' roundtrips
 *     • SNAPSHOT mode BranchScan planner path + frozen visibility (new writes
 *       by another session / branch remain invisible for the lifetime of the
 *       snapshot taken at use_branch entry)
 *     • LIVE mode BranchScan path + always-latest delta visibility
 *     • Snapshot consistency across repeated list_branches() / current_branch()
 *       invocations; 1-arg use_branch(x) resolves last-known mode stored in
 *       pg_branch.cur_mode
 *
 *   T2 — FR1 NOTIFY + FR4 throttling / DQL-vs-DML split kickout (SECTION A-K):
 *     • A) is_active(name) + force_invalidation_check() callable signatures,
 *       public synonym registration, GRANT to public
 *     • B) baseline: force_invalidation_check() returns true while branch
 *       still ACTIVE
 *     • C) INVALIDATION KICKOUT DQL path: manual UPDATE pg_branch.state =
 *       discarded → BranchScan fires NOTICE "reverting to Main" + falls back
 *       to MAIN heap; next statement ctx->is_active = false confirmed via
 *       is_active() wrapper
 *     • D) DQL / DML SPLIT OUT: same state applied flip on diff branch → DQL
 *       path NOTICE+fallback → DML UPDATE blocked ERRCODE 55000 drift-write
 *       0 MAIN rows written (pk=11 MAIN count = 0, verified via PL/pgSQL
 *       EXCEPTION CATCH block)
 *     • E) THROTTLE: default threshold=32 → 30 is_active() spins NO kickout;
 *       force_invalidation_check() opt-in bypass counter gate → fires
 *     • F) apply_branch() / discard_branch() self-broadcast Async_Notify
 *       (ob_branch_state) + self-cleanup → overlay_branch.current GUC = ''
 *       confirmed + catalog state = applied / discarded
 *     • G) is_active(branch_name) synonym ground truth: ACTIVE→t,
 *       APPLIED/DISCARDED→f
 *     • H) NOTIFY channel payload format: apply→"bid:applied",
 *       discard→"bid:discarded" matches FR1 spec (LISTEN/UNLISTEN code path
 *       exercised; raw psql PID-print lines suppressed via client_min_messages
 *       elevation to remove non-deterministic backend PIDs from regression
 *       baseline; payload-content + state assertions remain)
 *     • I) DISCARD non-current branch always broadcasts; current branch stays
 *       on A untouched + GUC no-leak
 *     • J) 4 new FR4 GUCs: default values 32 / 100ms / on / off; roundtrip
 *       SET 1 / 10ms / off / on → RESET → defaults back;
 *       force_invalidation_check() opt-in kickout returns false + NOTICE
 *     • K) BOUNDARY / NO-LEAK: K1–K4 is_active(name) false for nonexistent /
 *       applied / discarded; K5 use_branch(nonexistent) raises
 *       undefined_object; K6 guc_reset_ok PASS
 *
 * PRE-REQUISITE: shared_preload_libraries must include "overlay_branch" (the
 * Makefile `make check` target injects this via temp_instance_shared_libs.conf).
 * Running bare `pg_regress` without the shared lib hook → PRECHECK ABORT at
 * the very first DO block below.
 */
/* ---------- PRE-REQUISITE: shared_preload_libraries hook loaded ---------- */
DO $$
BEGIN
    IF current_setting('shared_preload_libraries', true) IS NULL
       OR current_setting('shared_preload_libraries', true)
          NOT LIKE '%overlay_branch%'
    THEN
        RAISE EXCEPTION
            'FAIL:PREQUISITE shared_preload_libraries must include overlay_branch. '
            'Hint: use the Makefile recipe (make install-home + make check), '
            'NOT bare pg_regress without --temp-config=.../temp_instance_shared_libs.conf.';
    END IF;
END $$;
CREATE EXTENSION IF NOT EXISTS overlay_branch;
SET client_min_messages = WARNING;
-- ========== PART A signatures ==========
SELECT CASE WHEN count(*) = 2 THEN 'PASS:A1 two-param signature exists'
            ELSE 'FAIL:A1 expected 2 use_branch rows, got ' || count(*)
       END AS t
FROM pg_proc
WHERE proname = 'use_branch'
  AND pronamespace = 'public'::regnamespace;
                 t                  
------------------------------------
 PASS:A1 two-param signature exists
(1 row)

SELECT CASE WHEN count(*) = 2 THEN 'PASS:A2 ext-schema two-param signature'
            ELSE 'FAIL:A2 expected 2 rows, got ' || count(*)
       END AS t
FROM pg_proc
WHERE proname = 'use_branch'
  AND pronamespace = 'overlay_branch'::regnamespace;
                   t                    
----------------------------------------
 PASS:A2 ext-schema two-param signature
(1 row)

SELECT CASE WHEN pronargs = 1 AND proargtypes[0]::regtype::text = 'name'
            THEN 'PASS:A3 1-param = name'
            ELSE 'FAIL:A3 pronargs=' || pronargs || ' first arg type=' || proargtypes[0]::regtype::text
       END AS t
FROM pg_proc
WHERE proname = 'use_branch' AND pronargs = 1
  AND pronamespace = 'overlay_branch'::regnamespace;
           t            
------------------------
 PASS:A3 1-param = name
(1 row)

SELECT CASE
            WHEN pronargs = 2
                 AND proargtypes[0]::regtype::text = 'name'
                 AND proargtypes[1]::regtype::text = 'text'
            THEN 'PASS:A4 2-param = name,text'
            ELSE 'FAIL:A4 pronargs=' || pronargs ||
                 ' arg_types=' || proargtypes[0]::regtype::text || ',' ||
                                     proargtypes[1]::regtype::text
       END AS t
FROM pg_proc
WHERE proname = 'use_branch' AND pronargs = 2
  AND pronamespace = 'overlay_branch'::regnamespace;
              t              
-----------------------------
 PASS:A4 2-param = name,text
(1 row)

SELECT CASE WHEN extversion::text >= '1.0' THEN 'PASS:A5 extversion=' || extversion
            ELSE 'FAIL:A5 extversion=' || extversion
       END AS t
FROM pg_extension WHERE extname = 'overlay_branch';
           t            
------------------------
 PASS:A5 extversion=1.0
(1 row)

